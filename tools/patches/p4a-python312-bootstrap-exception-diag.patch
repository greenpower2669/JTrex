 }
+
+#define P4A_DIAG_MAX_EXCEPTION_DEPTH 4
+#define P4A_DIAG_MAX_WIDE_CHARS 96
+
+static void p4a_diag_log_wide_path(const char *label, const wchar_t *value) {
+    char preview[1024];
+    size_t out = 0;
+    size_t i = 0;
+    const char *safe_label = label != NULL ? label : "<null-label>";
+
+    if (value == NULL) {
+        LOGP("P4A_DIAG %s=<null>", safe_label);
+        return;
+    }
+
+    while (value[i] != L'\0' &&
+           i < P4A_DIAG_MAX_WIDE_CHARS &&
+           out + 1 < sizeof(preview)) {
+        unsigned long codepoint = (unsigned long)value[i];
+        if (codepoint >= 0x20UL && codepoint <= 0x7eUL) {
+            preview[out++] = (char)codepoint;
+        } else {
+            int written;
+            if (codepoint <= 0xffffUL) {
+                written = snprintf(
+                    preview + out, sizeof(preview) - out,
+                    "\\u%04lx", codepoint);
+            } else {
+                written = snprintf(
+                    preview + out, sizeof(preview) - out,
+                    "\\U%08lx", codepoint);
+            }
+            if (written < 0 ||
+                (size_t)written >= sizeof(preview) - out) {
+                out = sizeof(preview) - 1;
+                break;
+            }
+            out += (size_t)written;
+        }
+        i += 1;
+    }
+
+    preview[out] = '\0';
+    LOGP("P4A_DIAG %s=%s", safe_label, preview);
+    if (value[i] != L'\0') {
+        LOGP("P4A_DIAG %s=<truncated after %d wide chars>",
+             safe_label, P4A_DIAG_MAX_WIDE_CHARS);
+    }
+}
+
+#if PY_VERSION_HEX >= 0x030C0000
+static void p4a_diag_log_exception_chain(
+        const char *label, PyObject *exception, int depth) {
+    const char *safe_label = label != NULL ? label : "<null-label>";
+
+    if (exception == NULL) {
+        LOGP("P4A_DIAG exception.%s=<none>", safe_label);
+        return;
+    }
+
+    const char *type_name = "<unknown>";
+    if (Py_TYPE(exception) != NULL && Py_TYPE(exception)->tp_name != NULL) {
+        type_name = Py_TYPE(exception)->tp_name;
+    }
+
+    PyObject *message_object = PyObject_Str(exception);
+    if (message_object != NULL) {
+        const char *message = PyUnicode_AsUTF8(message_object);
+        if (message != NULL) {
+            LOGP("P4A_DIAG exception.%s type=%s message=%s",
+                 safe_label, type_name, message);
+        } else {
+            LOGP("P4A_DIAG exception.%s type=%s message=<utf8 unavailable>",
+                 safe_label, type_name);
+            PyErr_Clear();
+        }
+        Py_DECREF(message_object);
+    } else {
+        LOGP("P4A_DIAG exception.%s type=%s message=<str unavailable>",
+             safe_label, type_name);
+        PyErr_Clear();
+    }
+
+    if (depth >= P4A_DIAG_MAX_EXCEPTION_DEPTH) {
+        LOGP("P4A_DIAG exception.%s=<chain depth limit reached>",
+             safe_label);
+        return;
+    }
+
+    PyObject *cause = PyException_GetCause(exception);
+    if (cause != NULL) {
+        p4a_diag_log_exception_chain("cause", cause, depth + 1);
+        Py_DECREF(cause);
+    }
+
+    PyObject *context = PyException_GetContext(exception);
+    if (context != NULL) {
+        p4a_diag_log_exception_chain("context", context, depth + 1);
+        Py_DECREF(context);
+    }
+}
+#endif
 
